    <dashboard enable-sort-zone-taborder='true' name='Dashboard 3'>
      <repository-location derived-from='http://localhost:9100/workbooks/Retail_BI_Report/Dashboard3?rev=' id='Dashboard3' path='/workbooks/Retail_BI_Report' revision='' />
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='6502' id='3' type-v2='text' w='98922' x='539' y='1078'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#1b1b1b' fontsize='16'>Selling behavior </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='78328' id='31' is-fixed='true' type-v2='layout-basic' w='98922' x='539' y='20594'>
            <zone h='78328' id='5' param='horz' type-v2='layout-flow' w='51752' x='539' y='20594'>
              <zone h='78328' id='8' name='Sales by date' w='51752' x='539' y='20594'>
                <layout-cache cell-count-w='143' minheight='285' non-cell-size-w='64' type-h='scalable' type-w='cell' />
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
            <zone h='78328' id='32' param='horz' type-v2='layout-flow' w='47170' x='52291' y='20594'>
              <zone h='78328' id='13' name='Sales by date outliers' w='47170' x='52291' y='20594'>
                <layout-cache cell-count-w='6' minheight='185' non-cell-size-w='64' type-h='scalable' type-w='cell' />
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone h='13014' id='12' param='horz' type-v2='layout-flow' w='6267' x='539' y='7580'>
            <zone h='13014' id='11' name='Sales by date' pane-specification-id='0' param='[federated.09c82i20zi96wa15g1bcy1swq6py].[none:isholiday:nk]' type-v2='color' w='6267' x='539' y='7580'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone forceUpdate='true' h='13014' id='17' type-v2='text' w='45485' x='6806' y='7580'>
            <formatted-text>
              <run fontcolor='#000000' fontsize='10'>Stores with weekly sales </run>
              <run bold='true' fontcolor='#000000' fontsize='10'>&gt;250k</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>We can observe that the behavior of the stores in big weeks is constant. There are two main big weeks for sales:</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Thanksgiving week</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>One week before Christmas (last minute gifts!</run>
